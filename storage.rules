rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // 0. DEFAULT DENY
    // =========================================================================
    // Bloqueo estricto por defecto para cualquier ruta no autorizada explícitamente
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. HELPER FUNCTIONS
    // =========================================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Validación de roles vía Custom Claims (instantáneo, sin latencia)
    function isClaimAdmin() {
      return signedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('isAdmin' in request.auth.token && request.auth.token.isAdmin == true) ||
        ('role' in request.auth.token && request.auth.token.role in ['admin', 'super', 'superadmin', 'recruiter'])
      );
    }

    function isClaimSuper() {
      return signedIn() && (
        ('super' in request.auth.token && request.auth.token.super == true) ||
        ('role' in request.auth.token && request.auth.token.role in ['super', 'superadmin'])
      );
    }

    // Fallback de roles leyendo documento en Firestore si el claim aún no fue propagado
    function isDocAdmin() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super', 'superadmin', 'recruiter'];
    }

    function isDocSuper() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['super', 'superadmin'];
    }

    function isAdmin() {
      return isClaimAdmin() || isDocAdmin();
    }

    function isSuper() {
      return isClaimSuper() || isDocSuper();
    }

    function isInstructor() {
      return signedIn() && (
        ('role' in request.auth.token && request.auth.token.role in ['instructor', 'teacher']) ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['instructor', 'teacher'] ||
        isAdmin()
      );
    }

    // Filtros de tipos de archivos MIME autorizados
    function isDocType() {
      return request.resource.contentType in [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      ];
    }

    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    // =========================================================================
    // 2. CVs DE POSTULACIONES REALES
    // =========================================================================
    // Ruta: users/{userId}/cvs/{applicationId}/{fileName}
    // Subida exclusiva del candidato dueño, tamaño < 10MB, formatos PDF/Word
    match /users/{userId}/cvs/{applicationId}/{fileName} {
      allow write: if isOwner(userId) &&
                   request.resource.size < 10 * 1024 * 1024 &&
                   isDocType();

      // Lectura y borrado: Solo el dueño de la postulación y reclutadores/administradores
      allow read, delete: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 3. PERFIL DE USUARIO: FOTOS Y CVs FUENTE
    // =========================================================================
    // Ruta: users/{userId}/profile/{fileName}
    // Fotos de perfil y hojas de vida públicas para reclutadores
    match /users/{userId}/profile/{fileName} {
      // Lectura pública para que las empresas y reclutadores vean fotos y CV de perfiles publicados
      allow read: if true;

      // Subida por el usuario dueño (imágenes o CV en PDF/Word < 10MB)
      allow write: if isOwner(userId) &&
                   request.resource.size < 10 * 1024 * 1024 &&
                   (isImageType() || isDocType());

      // Eliminación reservada al dueño o administrador
      allow delete: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 4. MATERIALES EDUCATIVOS DE B1 ACADEMY
    // =========================================================================
    // Ruta: courses/{courseId}/{allPaths=**}
    match /courses/{courseId}/{allPaths=**} {
      // Lectura para cualquier usuario/afiliado autenticado
      allow read: if signedIn();

      // Creación, edición y eliminación para instructores autorizados y administradores (< 50MB)
      allow write, delete: if (isInstructor() || isAdmin()) &&
                           request.resource.size < 50 * 1024 * 1024;
    }
  }
}
