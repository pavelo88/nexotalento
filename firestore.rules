rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid} {
      allow create: if owner(uid) && request.resource.data.accountType == 'candidate';
      allow read: if owner(uid) || admin();
      allow update: if admin() || (owner(uid) && request.resource.data.accountType == resource.data.accountType && request.resource.data.uid == resource.data.uid);
      allow delete: if admin();
    }
    match /applications/{id} { allow create: if signedIn() && request.resource.data.candidateUid == request.auth.uid && request.resource.data.status == 'received'; allow read: if admin() || (signedIn() && resource.data.candidateUid == request.auth.uid); allow update, delete: if admin(); }
    match /profiles/{slug} {
      allow read: if resource.data.published == true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (resource.data.ownerUid == request.auth.uid || admin());
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || admin());
    }
  }
}
